---
import type { CollectionEntry } from 'astro:content';
import { getRelease } from '../lib/content';
import { withBase } from '../lib/site';

interface Props {
	post: CollectionEntry<'blog'>;
	heading?: 'h2' | 'h3';
}

const { post, heading: Heading = 'h2' } = Astro.props;
const href = withBase(`blog/${post.id}/`);
const date = post.data.pubDate.toISOString().slice(0, 10);
const release = await getRelease(post);
---

<li class="journal-item">
	<div class="journal-stamp">
		<time datetime={post.data.pubDate.toISOString()}>{date}</time>
		{
			release && (
				<span>
					{release.title} <span class="journal-version">{release.version}</span>
				</span>
			)
		}
	</div>
	<div>
		<Heading>
			<a href={href}>{post.data.title}</a>
		</Heading>
		<p>{post.data.description}</p>
	</div>
</li>
