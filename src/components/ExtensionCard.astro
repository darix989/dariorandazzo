---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/site';

interface Props {
	extension: CollectionEntry<'extensions'>;
	heading?: 'h2' | 'h3';
}

const { extension, heading: Heading = 'h2' } = Astro.props;
const href = withBase(`projects/${extension.id}/`);
---

<li class="paper-card">
	<p class="card-kicker">
		<span class="dot" aria-hidden="true"></span>
		{extension.data.status}
		{
			extension.data.platforms.length > 0 && (
				<>
					<span aria-hidden="true">·</span>
					{extension.data.platforms.join(' · ')}
				</>
			)
		}
	</p>
	<Heading>
		<a href={href}>{extension.data.title}</a>
	</Heading>
	<p>{extension.data.description}</p>
</li>
