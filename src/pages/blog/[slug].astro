---
import { render, type CollectionEntry } from 'astro:content';
import TagLinks from '../../components/TagLinks.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/content';
import { blogPostingJsonLd } from '../../lib/jsonld';
import { withBase } from '../../lib/site';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const path = `blog/${post.id}/`;
const published = post.data.pubDate.toISOString().slice(0, 10);
const updated = post.data.updatedDate?.toISOString().slice(0, 10);
---

<BaseLayout
	title={post.data.title}
	description={post.data.description}
	path={path}
	ogType="article"
	publishedTime={post.data.pubDate}
	modifiedTime={post.data.updatedDate ?? post.data.pubDate}
	jsonLd={blogPostingJsonLd({
		title: post.data.title,
		description: post.data.description,
		path,
		pubDate: post.data.pubDate,
		updatedDate: post.data.updatedDate,
	})}
>
	<article>
		<p class="kicker">changelog</p>
		<h1>{post.data.title}</h1>
		<p class="meta">
			<time datetime={post.data.pubDate.toISOString()}>{published}</time>
			{updated && updated !== published && <> · Updated {updated}</>}
			{
				post.data.tags.length > 0 && (
					<>
						{' · '}
						<TagLinks tags={post.data.tags} />
					</>
				)
			}
		</p>
		{
			post.data.heroImage && (
				<img
					class="content-image"
					src={
						post.data.heroImage.startsWith('http')
							? post.data.heroImage
							: withBase(post.data.heroImage)
					}
					alt={post.data.heroImageAlt ?? ''}
					width={post.data.heroImageWidth}
					height={post.data.heroImageHeight}
					loading="eager"
				/>
			)
		}
		<div class="prose">
			<Content />
		</div>
	</article>
</BaseLayout>
