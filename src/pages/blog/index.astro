---
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/content';

const posts = await getPublishedPosts();
const description = 'Writing by Dario Randazzo.';
---

<BaseLayout title="Writing" description={description} path="blog/">
	<div class="page-intro">
		<p class="kicker">Journal</p>
		<h1>Writing</h1>
		<p class="lede">{description}</p>
	</div>
	{
		posts.length > 0 ? (
			<ul class="journal">
				{posts.map((post) => (
					<PostCard post={post} />
				))}
			</ul>
		) : (
			<p class="empty">No posts published yet. Add a Markdown file in src/content/blog/ with draft: false.</p>
		)
	}
</BaseLayout>
