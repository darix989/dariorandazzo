---
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/content';

const posts = await getPublishedPosts();
const description = 'Writing by Dario Randazzo.';
---

<BaseLayout title="Blog" description={description} path="blog/">
	<h1>Blog</h1>
	<p class="lede">{description}</p>
	{
		posts.length > 0 ? (
			<ul class="card-list">
				{posts.map((post) => (
					<PostCard post={post} />
				))}
			</ul>
		) : (
			<p class="empty">No posts published yet. Add a Markdown file in src/content/blog/ with draft: false.</p>
		)
	}
</BaseLayout>
