---
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/content';

const posts = await getPublishedPosts();
const description = 'Notes and posts by Dario Randazzo.';
---

<BaseLayout title="changelog" description={description} path="blog/">
	<div class="page-intro">
		<p class="kicker">log</p>
		<h1>changelog</h1>
		<p class="lede">{description}</p>
	</div>
	{
		posts.length > 0 ? (
			<ul class="journal">
				{posts.map((post) => (
					<PostCard post={post} />
				))}
			</ul>
		) : (
			<p class="empty">Changelog is empty.</p>
		)
	}
</BaseLayout>
