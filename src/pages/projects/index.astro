---
import ExtensionCard from '../../components/ExtensionCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedExtensions } from '../../lib/content';

const extensions = await getPublishedExtensions();
const description = 'Small tools that live in the browser.';
---

<BaseLayout title="releases" description={description} path="projects/">
	<div class="page-intro">
		<p class="kicker">Work</p>
		<h1>releases</h1>
		<p class="lede">{description}</p>
	</div>
	{
		extensions.length > 0 ? (
			<ul class="card-grid">
				{extensions.map((extension) => (
					<ExtensionCard extension={extension} />
				))}
			</ul>
		) : (
			<p class="empty">
				No releases published yet. Add a Markdown file in src/content/extensions/ with draft: false.
			</p>
		)
	}
</BaseLayout>
