---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedProjects } from '../../lib/content';
import { softwareApplicationJsonLd } from '../../lib/jsonld';

export async function getStaticPaths() {
	const projects = await getPublishedProjects();
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const path = `projects/${project.id}/`;
const links = [
	project.data.storeUrl && { href: project.data.storeUrl, label: 'Store' },
	project.data.repoUrl && { href: project.data.repoUrl, label: 'Source' },
	project.data.websiteUrl && { href: project.data.websiteUrl, label: 'Website' },
].filter((link): link is { href: string; label: string } => Boolean(link));
---

<BaseLayout
	title={project.data.title}
	description={project.data.description}
	path={path}
	jsonLd={softwareApplicationJsonLd({
		title: project.data.title,
		description: project.data.description,
		path,
		platforms: project.data.platforms,
	})}
>
	<article>
		<p class="kicker">build</p>
		<h1>{project.data.title}</h1>
		<p class="meta">
			{project.data.status}
			{project.data.platforms.length > 0 && <> · {project.data.platforms.join(', ')}</>}
		</p>
		{
			links.length > 0 && (
				<ul class="project-links">
					{links.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))}
				</ul>
			)
		}
		<div class="prose">
			<Content />
		</div>
	</article>
</BaseLayout>
