---
import { render } from 'astro:content';
import ExtensionCard from '../components/ExtensionCard.astro';
import PostCard from '../components/PostCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAbout, getFeaturedExtensions, getPublishedPosts } from '../lib/content';
import { personJsonLd, websiteJsonLd } from '../lib/jsonld';
import { SITE, withBase } from '../lib/site';

const about = await getAbout();
const { Content } = await render(about);
const extensions = await getFeaturedExtensions();
const posts = (await getPublishedPosts()).slice(0, 3);
---

<BaseLayout title={SITE.title} description={SITE.description} jsonLd={[websiteJsonLd(), personJsonLd()]}>
	<section class="hero" aria-labelledby="hero-heading">
		<p class="kicker">{SITE.jobTitle}</p>
		<h1 id="hero-heading">{SITE.author}</h1>
		<div class="measure prose">
			<Content />
		</div>
	</section>

	<section class="section" aria-labelledby="daemons-heading">
		<div class="section-head">
			<h2 class="section-label" id="daemons-heading">daemons</h2>
			<a class="more-link" href={withBase('projects/')}>All daemons</a>
		</div>
		{
			extensions.length > 0 ? (
				<ul class="card-grid">
					{extensions.map((extension) => (
						<ExtensionCard extension={extension} heading="h3" />
					))}
				</ul>
			) : (
				<p class="empty">No daemons published yet.</p>
			)
		}
	</section>

	<section class="section" aria-labelledby="changelog-heading">
		<div class="section-head">
			<h2 class="section-label" id="changelog-heading">changelog</h2>
			<a class="more-link" href={withBase('blog/')}>Full changelog</a>
		</div>
		{
			posts.length > 0 ? (
				<ul class="journal">
					{posts.map((post) => (
						<PostCard post={post} heading="h3" />
					))}
				</ul>
			) : (
				<p class="empty">Changelog is empty.</p>
			)
		}
	</section>
</BaseLayout>
