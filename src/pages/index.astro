---
import { render } from 'astro:content';
import ExtensionCard from '../components/ExtensionCard.astro';
import PostCard from '../components/PostCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAbout, getFeaturedExtensions, getPublishedPosts } from '../lib/content';
import { personJsonLd, websiteJsonLd } from '../lib/jsonld';
import { SITE, withBase } from '../lib/site';

const about = await getAbout();
const { Content } = await render(about);
const extensions = await getFeaturedExtensions();
const posts = (await getPublishedPosts()).slice(0, 3);
---

<BaseLayout title={SITE.title} description={SITE.description} jsonLd={[websiteJsonLd(), personJsonLd()]}>
	<section class="hero" aria-labelledby="hero-heading">
		<p class="kicker">{SITE.jobTitle}</p>
		<h1 id="hero-heading">{SITE.author}</h1>
		<div class="measure prose">
			<Content />
			<p>
				<a class="more-link" href={withBase('about/')}>Continue reading</a>
			</p>
		</div>
	</section>

	<section class="section" aria-labelledby="extensions-heading">
		<div class="section-head">
			<h2 class="section-label" id="extensions-heading">Extensions</h2>
			<a class="more-link" href={withBase('extensions/')}>All extensions</a>
		</div>
		{
			extensions.length > 0 ? (
				<ul class="card-grid">
					{extensions.map((extension) => (
						<ExtensionCard extension={extension} heading="h3" />
					))}
				</ul>
			) : (
				<p class="empty">No extensions published yet.</p>
			)
		}
	</section>

	<section class="section" aria-labelledby="blog-heading">
		<div class="section-head">
			<h2 class="section-label" id="blog-heading">Writing</h2>
			<a class="more-link" href={withBase('blog/')}>All posts</a>
		</div>
		{
			posts.length > 0 ? (
				<ul class="journal">
					{posts.map((post) => (
						<PostCard post={post} heading="h3" />
					))}
				</ul>
			) : (
				<p class="empty">No posts published yet.</p>
			)
		}
	</section>
</BaseLayout>
