---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Seo from '../components/Seo.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	path?: string;
	ogType?: 'website' | 'article';
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	ogImage?: string;
	publishedTime?: Date;
	modifiedTime?: Date;
	noindex?: boolean;
}

const { title, description, path, ogType, jsonLd, ogImage, publishedTime, modifiedTime, noindex } =
	Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<Seo
			title={title}
			description={description}
			path={path}
			ogType={ogType}
			jsonLd={jsonLd}
			ogImage={ogImage}
			publishedTime={publishedTime}
			modifiedTime={modifiedTime}
			noindex={noindex}
		/>
	</head>
	<body>
		<Header />
		<main id="main" class="site-main">
			<slot />
		</main>
		<Footer />
	</body>
</html>
